<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

  <display-name>Online Examination System</display-name>

  <!-- Landing page -->
  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!--
    SECURITY FILTERS
    ================
    Both filters are declared here (not via @WebFilter) because the servlet spec
    honours <filter-mapping> ORDER in web.xml but does NOT guarantee any order for
    @WebFilter annotations. We need Authentication to run BEFORE Authorization, so
    we list the authentication mappings first.
  -->
  <filter>
    <filter-name>AuthenticationFilter</filter-name>
    <filter-class>com.onlineexam.filter.AuthenticationFilter</filter-class>
  </filter>
  <filter>
    <filter-name>AuthorizationFilter</filter-name>
    <filter-class>com.onlineexam.filter.AuthorizationFilter</filter-class>
  </filter>

  <!-- Authentication first ... -->
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthenticationFilter</filter-name>
    <url-pattern>/student/*</url-pattern>
  </filter-mapping>

  <!-- ... then Authorization -->
  <filter-mapping>
    <filter-name>AuthorizationFilter</filter-name>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthorizationFilter</filter-name>
    <url-pattern>/student/*</url-pattern>
  </filter-mapping>

  <!-- Session: idle timeout + hardened cookie -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
      <!-- <secure>true</secure> enable when serving over HTTPS -->
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <!-- Friendly error pages (never leak stack traces to users) -->
  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/views/access-denied.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/error-404.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/error-500.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/views/error-500.jsp</location>
  </error-page>

</web-app>
